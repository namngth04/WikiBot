# =========================================================
# OFFLINE & LOCAL CONFIGURATION
# =========================================================
OFFLINE_MODE=True
LOCAL_DB_TYPE=sqlite
DATABASE_URL=sqlite:///./data/wikibot.db

# ChromaDB Client-only Persistent Path
CHROMA_TYPE=persistent
