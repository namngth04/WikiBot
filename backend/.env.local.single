MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Storage & Logging
DATA_DIR=./data
MAX_FILE_SIZE=50
LOG_LEVEL=INFO
RAG_LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG_MODE=true
