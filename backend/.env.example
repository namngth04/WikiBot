# WikiBot Backend Configuration
# Sao chép tệp này thành tệp .env thực tế trên máy của bạn (đã được Git ignore)
# Không commit file .env chứa thông tin bảo mật thật lên Git repo.

# =============================================
# REQUIRED: Security & Database
# =============================================

# JWT Configuration
# Khởi tạo khóa JWT bảo mật ngẫu nhiên cho Production
JWT_SECRET_KEY=YOUR_SUPER_SECRET_KEY_HERE_CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
# - Chạy Docker: postgresql://postgres:postgres@db:5432/wikibot
# - Chạy cục bộ: postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/wikibot
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/wikibot
LOCAL_DB_TYPE=postgresql

# Offline & Local Deployment Configuration
# - OFFLINE_MODE=True: Kích hoạt chế độ Offline ngoại tuyến 100%
# - ENVIRONMENT=development hoặc production
OFFLINE_MODE=False
ENVIRONMENT=development

# Encryption Key for API keys stored in database
# Sinh khóa ngẫu nhiên bằng lệnh: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# =============================================
# Vector DB & LLM Settings
# =============================================

# ChromaDB Configuration
# - CHROMA_TYPE=persistent (chạy sqlite local client) hoặc http (kết nối với Docker ChromaDB container)
# - CHROMA_HOST=chromadb (trong Docker) hoặc localhost (chạy local)
CHROMA_TYPE=persistent
CHROMA_DB_PATH=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000

# LLM Model Configuration (Local GGUF)
MODEL_PATH=./llm_models/qwen2.5-3b-instruct-q4_k_m.gguf
MODEL_CONTEXT_LENGTH=4096
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048

# Embedding Model
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# =============================================
# Application Settings & Directories
# =============================================

DATA_DIR=./data
MAX_FILE_SIZE=50
LOG_LEVEL=INFO
RAG_LOG_LEVEL=INFO

# =============================================
# Debug & Logging Configuration (Đồng bộ với .env thật)
# =============================================
DEBUG_MODE=true
LOG_FORMAT=console       # json, console
CORRELATION_ID_HEADER=X-Request-ID
