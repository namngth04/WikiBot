# WikiBot Backend Configuration
# Copy this file to .env and fill in your actual values

# =============================================
# REQUIRED: Security & Database
# =============================================

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./data/wikibot.db

# Encryption Key for API keys stored in database
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here-generate-a-new-one

# =============================================
# AI Configuration (Fallback - stored in DB now)
# These are used when database is empty or as defaults
# =============================================

# ChromaDB
CHROMA_DB_PATH=./chroma_db

# LLM Model Configuration (Local GGUF - fallback)
MODEL_PATH=./llm_models/qwen2.5-3b-instruct-q4_k_m.gguf
MODEL_CONTEXT_LENGTH=4096
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048

# Embedding Model (fallback)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# API Providers (examples - configure in Admin UI)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://localhost:11434

# =============================================
# Application Settings
# =============================================

# File Storage
DATA_DIR=./data
MAX_FILE_SIZE=50

# Logging
LOG_LEVEL=INFO
RAG_LOG_LEVEL=INFO

# =============================================
# NOTES:
# - AI configuration is now managed via Admin UI and stored in database
# - This .env file provides fallback values and required security keys
# - To change AI models: Go to Admin Panel -> Cấu hình AI
# - ENCRYPTION_KEY must be set before storing any API keys
# =============================================
