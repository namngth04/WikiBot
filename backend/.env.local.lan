# WikiBot Configuration - Chế độ Doanh nghiệp LAN Postgres (Offline 100%)
# Copy file này thành .env ở thư mục backend khi test Docker LAN Compose

# JWT & Security
JWT_SECRET_KEY=0bVV?R*M*_3+17GjWc1CYL^uf>-_1Av7D;02vjqqF1X?=W39R8op^%Ng=.a=+R~g
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=2GUQ4k-kFdfKy-HBdt2CAe52OoSCUb19mo4XcpzroHQ=

# =========================================================
# OFFLINE & LOCAL CONFIGURATION
# =========================================================
OFFLINE_MODE=True
LOCAL_DB_TYPE=postgresql

# Chuỗi kết nối Postgres local (Docker map cổng ngoài là 5435)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/wikibot

# ChromaDB Server Configuration (Docker map cổng ngoài là 8005)
CHROMA_TYPE=http
CHROMA_HOST=localhost
CHROMA_PORT=8005

# Local GGUF & Embedding Model Configuration
MODEL_PATH=./llm_models/qwen2.5-3b-instruct-q4_k_m.gguf
MODEL_CONTEXT_LENGTH=4096
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Storage & Logging
DATA_DIR=./data
MAX_FILE_SIZE=50
LOG_LEVEL=INFO
RAG_LOG_LEVEL=INFO
ENVIRONMENT=development
DEBUG_MODE=true
