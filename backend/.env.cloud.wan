OFFLINE_MODE=False

# Kết nối CSDL PostgreSQL Cloud của hệ thống SaaS
DATABASE_URL=postgresql://db_user:db_password@cloud_postgres_host:5432/wikibot_saas

# Cụm ChromaDB Server trên Cloud
CHROMA_TYPE=http
CHROMA_HOST=cloud_chroma_host
CHROMA_PORT=8000

# AI Configuration (Fallback - Manage models in Admin UI)
MODEL_PATH=./llm_models/qwen2.5-3b-instruct-q4_k_m.gguf
MODEL_CONTEXT_LENGTH=4096
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Storage & Logging
DATA_DIR=./data
MAX_FILE_SIZE=50
LOG_LEVEL=INFO
RAG_LOG_LEVEL=INFO
ENVIRONMENT=production
DEBUG_MODE=false
