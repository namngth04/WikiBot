# WikiBot Configuration - Chế độ Đa Doanh nghiệp Cloud WAN (Multi-Tenant SaaS)
# Copy file này thành .env ở thư mục backend khi triển khai trực tuyến trên Cloud

# JWT & Security
JWT_SECRET_KEY=0bVV?R*M*_3+17GjWc1CYL^uf>-_1Av7D;02vjqqF1X?=W39R8op^%Ng=.a=+R~g
